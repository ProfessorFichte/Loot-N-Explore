{
  "schemaVersion": 1,
  "id": "loot_n_explore",
  "version": "${version}",
  "name": "Loot N Explore",
  "description": "RPG-Structures, Mob Entities, Building Blocks and more.",
  "authors": [
    "Fichte"
  ],
  "contact": {
    "sources": "https://github.com/ProfessorFichte/Loot-N-Explore"
  },
  "license": "ARR",
  "icon": "assets/loot_n_explore/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lne.fabric.RPGLootFabric"
    ],
    "client": [
      "com.lne.fabric.client.RPGLootFabricClient"
    ],
    "fabric-datagen": [
      "more_rpg_loot.RPGLootDataGenerator"
    ]
  },
  "mixins": [
    "loot_n_explore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_compat_version}",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "structure_pool_api": "*",
    "mrpg_lib": "*"
  },
  "suggests": {
    "spell_engine": "*",
    "spell_power": "*",
    "ranged_weapon_api": "*",
    "witcher_rpg": "*",
    "critical_strike": "*",
    "lithostitched": "*",
    "trinkets": "*"
  },
  "custom": {
    "modmenu": {
      "modId": "loot_n_explore",
      "links": {
        "modmenu.discord": "https://discord.gg/AShKd5XrTu"
      }
    }
  }
}
