{
  "schemaVersion": 1,
  "id": "loot_n_explore",
  "version": "${version}",
  "name": "Loot & Explore",
  "description": "RPG-Structures, Mob Entities, Building Blocks and more.",
  "authors": [
    "Fichte"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/loot-n-explore",
    "sources": "https://github.com/ProfessorFichte/Loot-N-Explore",
    "issues": "https://github.com/ProfessorFichte/Loot-N-Explore/issues"
  },
  "license": "ARR",
  "icon": "assets/loot_n_explore/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lne.fabric.LneFabric"
    ],
    "client": [
      "com.lne.fabric.client.LneFabricClient"
    ],
    "fabric-datagen": [
      "lne.LneDataGenerator"
    ]
  },
  "mixins": [
    "loot_n_explore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_compat_version}",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "structure_pool_api": "*",
    "mrpg_lib": ">=${more_rpg_library_version}"
  },
  "suggests": {
    "spell_engine": "*",
    "spell_power": "*",
    "ranged_weapon_api": "*",
    "witcher_rpg": "*",
    "critical_strike": "*",
    "lithostitched": "*",
    "trinkets": "*"
  },
  "custom": {
    "modmenu": {
      "modId": "loot_n_explore",
      "links": {
        "modmenu.discord": "https://discord.gg/AShKd5XrTu",
        "modmenu.kofi": "https://ko-fi.com/fichteee",
        "modmenu.modrinth": "https://modrinth.com/mod/loot-n-explore",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/loot-n-explore"
      }
    }
  }
}
